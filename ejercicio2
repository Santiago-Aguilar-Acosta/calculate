import pandas as pd

def calculate_demographic_data():
    # Leer los datos
    df = pd.read_csv('adult.data.csv')

    # 1. Raza: Cuántas personas de cada raza
    race_count = df['race'].value_counts()

    # 2. Edad promedio de los hombres
    average_age_men = round(df[df['sex'] == 'Male']['age'].mean(), 1)

    # 3. Porcentaje de personas con título de Bachelor
    percentage_bachelors = round((df['education'] == 'Bachelors').sum() / len(df) * 100, 1)

    # 4. Porcentaje de personas con educación avanzada (Bachelors, Masters, Doctorate) que ganan >50K
    advanced_education = df['education'].isin(['Bachelors', 'Masters', 'Doctorate'])
    higher_salary = df['salary'] == '>50K'

    # Número de personas con educación avanzada
    num_advanced = advanced_education.sum()
    # Número de personas con educación avanzada y salario >50K
    num_advanced_rich = (advanced_education & higher_salary).sum()

    percentage_advanced_rich = round(num_advanced_rich / num_advanced * 100, 1)

    # 5. Porcentaje de personas sin educación avanzada que ganan >50K
    num_non_advanced = (~advanced_education).sum()
    num_non_advanced_rich = ((~advanced_education) & higher_salary).sum()

    percentage_non_advanced_rich = round(num_non_advanced_rich / num_non_advanced * 100, 1)

    # 6. Mínimo de horas trabajadas por semana
    min_work_hours = df['hours-per-week'].min()

    # 7. Porcentaje de personas que trabajan el mínimo de horas y ganan >50K
    num_min_workers = (df['hours-per-week'] == min_work_hours).sum()
    rich_min_workers = ((df['hours-per-week'] == min_work_hours) & higher_salary).sum()

    percentage_rich_min_workers = round(rich_min_workers / num_min_workers * 100, 1) if num_min_workers > 0 else 0

    # 8. País con el mayor porcentaje de personas que ganan >50K
    # Agrupar por país y calcular el porcentaje de salarios >50K en cada país
    country_salary = df.groupby('native-country')['salary'].apply(lambda x: (x == '>50K').sum() / x.count() * 100)
    highest_earning_country = country_salary.idxmax()
    highest_earning_country_percentage = round(country_salary.max(), 1)

    # 9. Ocupación más popular para aquellos que ganan >50K en India
    india_rich = df[(df['native-country'] == 'India') & (df['salary'] == '>50K')]
    top_IN_occupation = india_rich['occupation'].value_counts().idxmax()

    return {
        'race_count': race_count,
        'average_age_men': average_age_men,
        'percentage_bachelors': percentage_bachelors,
        'advanced_education_rich_percentage': percentage_advanced_rich,
        'non_advanced_education_rich_percentage': percentage_non_advanced_rich,
        'min_work_hours': min_work_hours,
        'rich_percentage_min_workers': percentage_rich_min_workers,
        'highest_earning_country': highest_earning_country,
        'highest_earning_country_percentage': highest_earning_country_percentage,
        'top_IN_occupation': top_IN_occupation
    }
